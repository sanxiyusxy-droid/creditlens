APP_ENV=local
DATABASE_URL=postgresql+asyncpg://creditlens:creditlens@localhost:5432/creditlens
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_CHUNKS_ALIAS=credit_chunks_active
QDRANT_SUMMARIES_ALIAS=credit_summaries_active
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_RAW_BUCKET=creditlens-raw
MINIO_DERIVED_BUCKET=creditlens-parsed
MINIO_RENDERED_BUCKET=creditlens-rendered

# --- 生成模型（OpenAI 兼容，如 DeepSeek）---
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=

# --- Embedding（OpenAI 兼容，如硅基流动 BAAI/bge-m3）---
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# --- Reranker（http = TEI 风格 /rerank；KEY 为空时复用 EMBEDDING_API_KEY）---
RERANK_PROVIDER=http
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 离线兜底模式：EMBEDDING_PROVIDER=hash_fallback / RERANK_PROVIDER=lexical_fallback / LLM_PROVIDER=disabled
SPARSE_ENCODER_VERSION=bm25-jieba-v1
OTEL_EXPORTER_OTLP_ENDPOINT=
