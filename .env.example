APP_ENV=local
API_IDENTITY_MODE=demo
ALLOW_INSECURE_DEMO_IDENTITY=true
# 以下口令仅供本地 Compose 演示；部署前必须替换且不得提交真实密钥。
# 应用只能使用 NOSUPERUSER/NOBYPASSRLS 业务角色；迁移命令单独使用管理员连接。
DATABASE_URL=postgresql+asyncpg://creditlens_app:creditlens_app@localhost:5432/creditlens
APP_DB_PASSWORD=creditlens_app
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_CHUNKS_ALIAS=credit_chunks_active
QDRANT_SUMMARIES_ALIAS=credit_summaries_active
MINIO_ENDPOINT=localhost:9000
OBJECT_STORE_BACKEND=local_fs
# 本地 MinIO 演示凭据；任何共享或生产环境必须替换。
MINIO_ACCESS_KEY=creditlens
MINIO_SECRET_KEY=creditlens-dev-secret
MINIO_RAW_BUCKET=creditlens-raw
MINIO_DERIVED_BUCKET=creditlens-parsed
MINIO_RENDERED_BUCKET=creditlens-rendered

# --- 默认离线且不外发数据；需要真实模型时显式改为 openai_compatible ---
LLM_PROVIDER=disabled
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- Grounded QA：生产环境建议关闭抽取式离线兜底，并显式配置 LLM ---
QA_PROMPT_VERSION=grounded_qa_v1
QA_MAX_CLAIMS=6
QA_MAX_GENERATION_TOKENS=2048
QA_MAX_AUDIT_REPAIRS=1
QA_ALLOW_EXTRACTIVE_FALLBACK=false

# --- v1.5 调用账本与可靠投递 ---
# 生产环境注入至少 32 字节随机密钥；不得把真实密钥提交到仓库。
INVOCATION_FINGERPRINT_SECRET=
INVOCATION_FINGERPRINT_KEY_VERSION=runtime-ephemeral-v1
INVOCATION_CANCEL_PERSIST_TIMEOUT_SECONDS=2.0
# API 默认不启动 exporter。生产应使用具备 service role 或 tenant shard 身份的独立 worker。
TELEMETRY_OUTBOX_WORKER_ENABLED=false
TELEMETRY_EXPORTER_BACKEND=disabled
TELEMETRY_EXPORT_BATCH_SIZE=32
TELEMETRY_EXPORT_POLL_SECONDS=2.0
TELEMETRY_EXPORT_MAX_ATTEMPTS=5
TELEMETRY_EXPORT_LEASE_SECONDS=60
TELEMETRY_EXPORT_BASE_BACKOFF_SECONDS=5
TELEMETRY_EXPORT_MAX_BACKOFF_SECONDS=300

# --- Embedding：离线可复现默认值 ---
EMBEDDING_PROVIDER=hash_fallback
EMBEDDING_VERSION=hash-embed-v1
EMBEDDING_DIM=256
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Reranker：disabled | lexical_fallback | http ---
RERANK_PROVIDER=disabled
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=

SPARSE_ENCODER_VERSION=bm25-jieba-v1
OTEL_EXPORTER_OTLP_ENDPOINT=
