{
  "$defs": {
    "AblationScenario": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "unsupported_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Claim Ids",
          "type": "array"
        },
        "counter_evidence_target_ids": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence Target Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "component_harness": {
          "$ref": "#/$defs/ComponentHarnessFixture"
        }
      },
      "required": [
        "scenario_id",
        "description",
        "component_harness"
      ],
      "title": "AblationScenario",
      "type": "object"
    },
    "AblationVariant": {
      "enum": [
        "FULL",
        "NO_CHALLENGER",
        "NO_AUDITOR",
        "SINGLE_AGENT_BASELINE"
      ],
      "title": "AblationVariant",
      "type": "string"
    },
    "AblationVariantDefinition": {
      "additionalProperties": false,
      "properties": {
        "variant": {
          "$ref": "#/$defs/AblationVariant"
        },
        "execution_semantics": {
          "$ref": "#/$defs/ExecutionSemantics"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "disabled_components": {
          "items": {
            "type": "string"
          },
          "title": "Disabled Components",
          "type": "array"
        }
      },
      "required": [
        "variant",
        "execution_semantics",
        "description"
      ],
      "title": "AblationVariantDefinition",
      "type": "object"
    },
    "ComponentHarnessFixture": {
      "additionalProperties": false,
      "description": "Frozen component inputs; no gold answer is generated by the collector.",
      "properties": {
        "as_of_date": {
          "format": "date",
          "title": "As Of Date",
          "type": "string"
        },
        "claim_category": {
          "enum": [
            "ELIGIBILITY",
            "FINANCIAL",
            "CASH_FLOW",
            "CONCENTRATION",
            "RELATED_PARTY",
            "DATA_CONFLICT",
            "MISSING_MATERIAL",
            "EXCEPTION"
          ],
          "title": "Claim Category",
          "type": "string"
        },
        "claim_statement": {
          "minLength": 1,
          "title": "Claim Statement",
          "type": "string"
        },
        "evidence_mode": {
          "$ref": "#/$defs/HarnessEvidenceMode"
        },
        "expected_contract_violation_substrings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Expected Contract Violation Substrings",
          "type": "object"
        },
        "counter_evidence": {
          "items": {
            "$ref": "#/$defs/HarnessCounterEvidence"
          },
          "title": "Counter Evidence",
          "type": "array"
        }
      },
      "required": [
        "as_of_date",
        "claim_category",
        "claim_statement",
        "evidence_mode"
      ],
      "title": "ComponentHarnessFixture",
      "type": "object"
    },
    "ExecutionSemantics": {
      "enum": [
        "DETERMINISTIC_COMPONENT_HARNESS"
      ],
      "title": "ExecutionSemantics",
      "type": "string"
    },
    "HarnessCounterEvidence": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "expected_conflict": {
          "title": "Expected Conflict",
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "text",
        "expected_conflict"
      ],
      "title": "HarnessCounterEvidence",
      "type": "object"
    },
    "HarnessEvidenceMode": {
      "description": "How the frozen harness materializes the scenario's primary evidence.",
      "enum": [
        "DOCUMENT_SPAN",
        "POLICY_RULE",
        "SQL_FACT",
        "UNKNOWN_REFERENCE"
      ],
      "title": "HarnessEvidenceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_id": {
      "const": "creditlens_multi_agent_ablation_v1",
      "title": "Protocol Id",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "frozen": {
      "const": true,
      "title": "Frozen",
      "type": "boolean"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/AblationVariantDefinition"
      },
      "title": "Variants",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/AblationScenario"
      },
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    }
  },
  "required": [
    "protocol_id",
    "protocol_version",
    "frozen",
    "variants",
    "scenarios"
  ],
  "title": "AgentAblationDataset",
  "type": "object"
}
