              "prediction_count",
              "idempotent_replay_count",
              "generation_return_code",
              "scoring_return_code",
              "predictions_path",
              "scoring_dataset_path",
              "report_path",
              "query_dataset_sha256",
              "answer_dataset_sha256",
              "source_gold_sha256",
              "predictions_sha256",
              "scoring_dataset_sha256",
              "report_sha256",
              "runtime_profile_sha256",
              "git_commit",
              "git_dirty",
              "source_state_sha256",
              "source_state_algorithm",
              "source_state_scope",
              "source_state_file_count",
              "evidence_maturity",
              "summary"
            ]
          }
