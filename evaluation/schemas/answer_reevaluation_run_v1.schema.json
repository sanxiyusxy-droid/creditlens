    "AnswerSuiteStageName": {
      "enum": [
        "smoke",
        "full"
      ],
      "title": "AnswerSuiteStageName",
      "type": "string"
    },
    "AnswerSuiteStageRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "smoke"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "expected_question_count": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "full"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "expected_question_count": {
                "const": 41
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PLANNED"
              }
            },
            "required": [
              "status"
