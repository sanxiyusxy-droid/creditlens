          "then": {
            "properties": {
              "prediction_count": {
                "const": 3,
                "type": "integer"
              },
              "summary": {
                "properties": {
                  "technical_failures": {
                    "const": 0,
                    "type": "integer"
                  },
                  "total_questions": {
                    "const": 3,
                    "type": "integer"
                  }
                },
                "required": [
                  "technical_failures",
                  "total_questions"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "full"
              },
              "status": {
                "const": "COMPLETED"
              }
            },
            "required": [
              "name",
              "status"
            ]
          },
          "then": {
            "properties": {
              "prediction_count": {
                "const": 41,
                "type": "integer"
              },
              "summary": {
                "properties": {
                  "total_questions": {
                    "const": 41,
                    "type": "integer"
                  }
                },
                "required": [
                  "total_questions"
                ],
                "type": "object"
              }
            }
          }
        }
