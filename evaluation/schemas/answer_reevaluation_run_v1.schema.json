            "properties": {
              "predictions_path": {
                "minLength": 1,
                "type": "string"
              },
              "scoring_dataset_path": {
                "minLength": 1,
                "type": "string"
              },
              "report_path": {
                "minLength": 1,
                "type": "string"
              },
              "query_dataset_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "answer_dataset_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "source_gold_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "predictions_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "scoring_dataset_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "report_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "runtime_profile_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "source_state_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "prediction_count": {
                "minimum": 0,
                "type": "integer"
              },
              "idempotent_replay_count": {
                "const": 0,
                "type": "integer"
              },
              "generation_return_code": {
                "const": 0,
                "type": "integer"
              },
              "scoring_return_code": {
                "const": 0,
                "type": "integer"
              },
              "git_commit": {
                "pattern": "^[0-9a-f]{7,64}$",
                "type": "string"
              },
              "git_dirty": {
                "type": "boolean"
              },
              "source_state_algorithm": {
                "const": "sha256-canonical-file-manifest-v1",
                "type": "string"
              },
              "source_state_scope": {
                "const": "creditlens-runtime-evidence-v1",
                "type": "string"
              },
              "source_state_file_count": {
                "minimum": 1,
                "type": "integer"
              },
              "evidence_maturity": {
                "enum": [
                  "DEVELOPMENT_SOURCE_BOUND",
                  "RELEASE_CANDIDATE"
