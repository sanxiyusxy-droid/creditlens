                "type": "null"
              },
              "predictions_sha256": {
                "type": "null"
              },
              "scoring_dataset_sha256": {
                "type": "null"
              },
              "report_sha256": {
                "type": "null"
              },
              "runtime_profile_sha256": {
                "type": "null"
              },
              "git_commit": {
                "type": "null"
              },
              "git_dirty": {
                "type": "null"
              },
              "source_state_sha256": {
                "type": "null"
              },
              "source_state_algorithm": {
                "type": "null"
              },
              "source_state_scope": {
                "type": "null"
              },
              "source_state_file_count": {
                "type": "null"
              },
              "evidence_maturity": {
                "type": "null"
              },
              "summary": {
                "type": "null"
              },
              "failure_phase": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "RUNNING"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "failure_phase": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "failure_phase": {
                "enum": [
                  "GENERATION",
                  "SCORING",
                  "VALIDATION",
                  "INTERRUPTED"
                ],
                "type": "string"
              }
            },
            "required": [
              "failure_phase"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              },
              "failure_phase": {
                "const": "GENERATION"
              }
            },
            "required": [
              "status",
              "failure_phase"
            ]
          },
          "then": {
            "properties": {
              "generation_return_code": {
                "not": {
                  "const": 0
                },
                "type": "integer"
              }
            },
            "required": [
              "generation_return_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              },
              "failure_phase": {
                "const": "SCORING"
              }
            },
            "required": [
              "status",
              "failure_phase"
            ]
          },
          "then": {
            "properties": {
              "scoring_return_code": {
                "not": {
                  "const": 0
                },
                "type": "integer"
              }
            },
            "required": [
              "scoring_return_code"
            ]
          }
        },
        {
