        "expected_action": {
          "const": "BLOCK",
          "title": "Expected Action",
          "type": "string"
        },
        "expected_workflow_status": {
          "const": "HUMAN_REVIEW",
          "title": "Expected Workflow Status",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "injection_type",
        "as_of_date",
        "synthetic_claim",
        "expected_violation_codes",
        "expected_action",
        "expected_workflow_status"
