      "const": "creditlens_fail_closed_cases_v1",
      "title": "Protocol Id",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "frozen": {
